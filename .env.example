# --- App ---
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000

# --- Database (MySQL) ---
DATABASE_URL=mysql://migratech:migratech@localhost:3306/migratech

# --- WhatsApp (Baileys — unofficial WhatsApp Web multi-device client) ---
# No access token/phone number ID needed: on first run, scan the QR code printed in the
# terminal with WhatsApp (Settings > Linked Devices > Link a Device). Session credentials
# are then cached in BAILEYS_AUTH_DIR so you don't have to re-scan on every restart.
BAILEYS_AUTH_DIR=./storage/baileys-auth
# Minimum ms between outbound messages (jittered up to +50%) — every send (replies +
# scheduled reminders) is throttled through this, to avoid burst patterns that make
# WhatsApp more likely to flag/ban an unofficial client. Raise if you're doing bulk sends
# and can tolerate slower delivery; lower at your own risk.
WHATSAPP_MIN_SEND_INTERVAL_MS=1200
# Per-sender cap on inbound messages we'll process — a flooding number beyond this is
# dropped (not queued), protecting AI cost and stopping a burst of outbound replies.
WHATSAPP_INBOUND_RATE_LIMIT_MAX=10
WHATSAPP_INBOUND_RATE_LIMIT_WINDOW_MS=60000
# Per-recipient cap on outbound sends, independent of the pacing above — stops a bug/loop
# from hammering one number, a known trigger for WhatsApp banning an unofficial client.
WHATSAPP_OUTBOUND_RATE_LIMIT_MAX=30
WHATSAPP_OUTBOUND_RATE_LIMIT_WINDOW_MS=3600000
# Optional safety check, NOT a way to configure which number the bot uses — Baileys has no
# such setting; the number is whatever WhatsApp account scans the QR code. If set, the bot
# refuses to run when the linked session doesn't match this number, so an accidental scan
# with the wrong phone can't silently start sending as that account.
BOT_PHONE_NUMBER=
# WhatsApp display name + message footer branding. Does not change the welcome/menu/legal
# copy (that's business content, not just a name) — see conversation/flows.js for that.
BOT_NAME=MigraTech

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.6
# Global cap on OpenAI calls (extraction + grounded answers share one budget) — bounds
# worst-case cost and stays clear of OpenAI's own rate limits. Calls beyond the cap fall
# back to the same rule-based/raw-snippet paths used when no API key is set at all.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# --- Admin (seeds one 'admin'-role account on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs the admin dashboard's session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET_KEY=

# --- Consultation / escalation notification (optional) ---
STAFF_NOTIFICATION_WEBHOOK_URL=

# --- Document encryption at rest ---
# 32 random bytes, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
DOCUMENT_STORAGE_DIR=./storage/documents

# --- Data retention (off by default — see README) ---
DATA_RETENTION_DAYS=365
ENABLE_DATA_RETENTION_JOB=false

# --- Background scheduler (reminders, retention) ---
ENABLE_SCHEDULER=true

# --- Payments (Paystack) — DISCOVER (free) / NAVIGATE / RELOCATE package model ---
# NAVIGATE is sold self-serve by the bot via a Paystack checkout link. RELOCATE's price
# varies by pathway/service, so it's never auto-priced — staff issue a custom-amount
# Paystack link from the admin Payments page instead.
PAYSTACK_SECRET_KEY=
# Not currently used server-side (no in-page checkout widget, only Paystack's hosted
# checkout page) — kept here for reference/future use.
PAYSTACK_PUBLIC_KEY=
# Placeholder — this is NOT a real price. Set to MigraTech's actual NAVIGATE fee (in whole
# Naira, e.g. 15000 for ₦15,000) before taking real payments.
NAVIGATE_PRICE_NGN=15000
# Webhook URL to configure in the Paystack dashboard: https://<your-domain>/webhooks/paystack
