<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MigraTech Admin</title>
  <link rel="icon" type="image/png" href="/admin/static/brand/favicon.png" />
  <link rel="stylesheet" href="/admin/static/styles.css" />
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="brand">
      <img src="/admin/static/brand/logo-full.png" alt="MigraTech" class="brand-logo" />
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Core</div>
      <nav>
        <a href="/admin/" class="<%= active === 'overview' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/><path d="M9 22V12h6v10"/></svg>
          <span class="label">Overview</span>
        </a>
        <a href="/admin/leads" class="<%= active === 'leads' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="label">Leads</span>
        </a>
        <a href="/admin/conversations" class="<%= active === 'conversations' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-1 4 8.5 8.5 0 0 1-7.5 4.5 8.4 8.4 0 0 1-4-1L3 21l2-5.5a8.4 8.4 0 0 1-1-4A8.5 8.5 0 0 1 8.5 3a8.4 8.4 0 0 1 4-1H13a8.5 8.5 0 0 1 8 8.5z"/></svg>
          <span class="label">Conversations</span>
          <% if (nav_counts.escalated) { %><span class="badge"><%= nav_counts.escalated %></span><% } %>
        </a>
        <a href="/admin/applications" class="<%= active === 'applications' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
          <span class="label">Applications</span>
        </a>
        <a href="/admin/tasks" class="<%= active === 'tasks' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span class="label">Tasks</span>
          <% if (nav_counts.tasks) { %><span class="badge"><%= nav_counts.tasks %></span><% } %>
        </a>
      </nav>
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Operations</div>
      <nav>
        <a href="/admin/payments" class="<%= active === 'payments' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
          <span class="label">Payments</span>
          <% if (nav_counts.payments) { %><span class="badge"><%= nav_counts.payments %></span><% } %>
        </a>
        <a href="/admin/documents" class="<%= active === 'documents' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
          <span class="label">Documents</span>
          <% if (nav_counts.documents) { %><span class="badge"><%= nav_counts.documents %></span><% } %>
        </a>
        <a href="/admin/consultations" class="<%= active === 'consultations' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
          <span class="label">Consultations</span>
        </a>
        <a href="/admin/knowledge" class="<%= active === 'knowledge' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="label">Knowledge base</span>
        </a>
        <a href="/admin/content" class="<%= active === 'content' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          <span class="label">Content</span>
        </a>
        <a href="/admin/messages" class="<%= active === 'messages' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
          <span class="label">Messages</span>
          <% if (nav_counts.messages) { %><span class="badge"><%= nav_counts.messages %></span><% } %>
        </a>
        <a href="/admin/company" class="<%= active === 'company' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1"/></svg>
          <span class="label">Company</span>
        </a>
        <a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="label">Users</span>
        </a>
      </nav>
    </div>

    <% if (user.role === 'admin') { %>
    <div class="nav-group">
      <div class="nav-group-label">System</div>
      <nav>
        <a href="/admin/whatsapp" class="<%= active === 'whatsapp' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-1 4 8.5 8.5 0 0 1-7.5 4.5 8.4 8.4 0 0 1-4-1L3 21l2-5.5a8.4 8.4 0 0 1-1-4A8.5 8.5 0 0 1 8.5 3a8.4 8.4 0 0 1 4-1H13a8.5 8.5 0 0 1 8 8.5z"/></svg>
          <span class="label">WhatsApp</span>
        </a>
        <a href="/admin/staff" class="<%= active === 'staff' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4z"/></svg>
          <span class="label">Staff</span>
        </a>
        <a href="/admin/audit-log" class="<%= active === 'audit_log' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span class="label">Audit log</span>
        </a>
        <a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82A1.65 1.65 0 0 0 3 13.09H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span class="label">Settings</span>
        </a>
      </nav>
    </div>
    <% } %>

    <div class="sidebar-foot">
      <div class="sidebar-user">
        <div class="avatar-circle"><%= user.username.slice(0, 2).toUpperCase() %></div>
        <div class="who">
          <b><%= user.username %></b>
          <span><%= user.role %></span>
        </div>
      </div>
      <form method="post" action="/admin/logout">
        <button type="submit">Log out</button>
      </form>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <h1><%= title %></h1>
      <div class="topbar-search">
        <form method="get" action="/admin/search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input name="q" placeholder="Search name, WhatsApp number..." />
        </form>
      </div>
      <div class="topbar-right">
        <a class="bell-link" href="/admin/conversations?escalated=1" title="Escalated conversations">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <% if (nav_counts.escalated) { %><span class="dot"><%= nav_counts.escalated %></span><% } %>
        </a>
        <div class="topbar-user">
          <div class="avatar-circle" style="width:30px;height:30px;font-size:11px;"><%= user.username.slice(0, 2).toUpperCase() %></div>
          <div class="who"><b><%= user.username %></b><span><%= user.role %></span></div>
        </div>
      </div>
    </div>
    <div class="content">
      <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
