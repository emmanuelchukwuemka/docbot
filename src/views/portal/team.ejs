<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Our Team — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
<style>
.team-avatar { width: 100%; height: 200px; object-fit: cover; background: #F3F4F6; }
.team-avatar-fallback { width: 100%; height: 200px; background: linear-gradient(135deg, #e8f7ee, #f3f4f6); display: flex; align-items: center; justify-content: center; font-size: 42px; font-weight: 900; color: #00B140; }
.team-role { font-size: 12.5px; font-weight: 700; color: #00B140; margin-bottom: 8px; }
</style>
</head>
<body>

<%- include('partials/nav') %>

<header class="content-header">
  <div class="container">
    <div class="content-eyebrow">Company</div>
    <h1>Our Team</h1>
  </div>
</header>

<div class="content-body">
  <% if (members.length) { %>
    <div class="content-grid">
      <% members.forEach(function(m) { %>
        <div class="content-card" style="cursor:default">
          <% if (m.photo_url) { %><img class="team-avatar" src="<%= m.photo_url %>" alt="<%= m.name %>" />
          <% } else { %><div class="team-avatar-fallback"><%= m.name.trim().split(/\s+/).slice(0,2).map(function(w){return w[0]}).join('').toUpperCase() %></div><% } %>
          <div class="content-card-body">
            <h3><%= m.name %></h3>
            <% if (m.role) { %><div class="team-role"><%= m.role %></div><% } %>
            <% if (m.bio) { %><p><%= m.bio %></p><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="content-empty">Team profiles are coming soon.</div>
  <% } %>
</div>

<%- include('partials/footer') %>

</body>
</html>
