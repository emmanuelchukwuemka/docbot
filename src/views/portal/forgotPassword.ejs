<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Forgot password — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%- include('partials/nav') %>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-eyebrow">Account Recovery</div>
    <h1>Forgot your password?</h1>

    <% if (sent) { %>
      <p class="auth-sub">If that email or WhatsApp number matches an account, we've sent a reset code to its WhatsApp number.</p>
      <a href="/reset-password" class="auth-submit" style="display:block;text-align:center;text-decoration:none;box-sizing:border-box">Enter code →</a>
    <% } else { %>
      <p class="auth-sub">Enter the email or WhatsApp number on your account — we'll send a reset code to your WhatsApp.</p>
      <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>
      <form method="post" action="/forgot-password">
        <div class="field">
          <label for="identifier">Email or WhatsApp number</label>
          <input id="identifier" name="identifier" required autofocus />
        </div>
        <button type="submit" class="auth-submit">Send Reset Code</button>
      </form>
    <% } %>

    <div class="auth-switch">Remembered it? <a href="/login">Log in</a></div>
  </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
