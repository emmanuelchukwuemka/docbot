<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Reset password — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%- include('partials/nav') %>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-eyebrow">Account Recovery</div>
    <h1>Reset your password</h1>
    <p class="auth-sub">Enter the code we sent to your WhatsApp number, and your new password.</p>

    <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>

    <form method="post" action="/reset-password">
      <div class="field">
        <label for="code">Reset code</label>
        <input id="code" name="code" required autofocus maxlength="6" inputmode="numeric" pattern="[0-9]{6}" placeholder="000000" style="letter-spacing:6px;font-size:20px;text-align:center" />
      </div>
      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" required minlength="8" />
      </div>
      <div class="field">
        <label for="password_confirm">Retype new password</label>
        <input id="password_confirm" name="password_confirm" type="password" required minlength="8" />
      </div>
      <button type="submit" class="auth-submit">Reset Password</button>
    </form>

    <form method="post" action="/reset-password/resend" style="margin-top:14px">
      <button type="submit" class="btn-mini" style="width:100%;justify-content:center;display:flex">Resend code</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
