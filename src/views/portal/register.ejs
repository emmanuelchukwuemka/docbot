<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Create your account — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%- include('partials/nav') %>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-eyebrow">Get Started</div>
    <h1>Create your account</h1>
    <p class="auth-sub">One account for your WhatsApp conversation, applications, documents and payments.</p>

    <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>

    <form method="post" action="/register">
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" name="name" required autofocus value="<%= values.name || '' %>" />
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" required value="<%= values.email || '' %>" />
      </div>
      <div class="field">
        <label for="whatsapp_local_number">WhatsApp number</label>
        <div class="field-row" style="gap:8px">
          <select id="whatsapp_dial_code" name="whatsapp_dial_code" required style="max-width:150px;flex:none">
            <% dialCodes.forEach(function(d) { %>
              <option value="<%= d.dial %>" <%= (values.whatsapp_dial_code || '234') === d.dial ? 'selected' : '' %>>+<%= d.dial %> <%= d.name %></option>
            <% }) %>
          </select>
          <input id="whatsapp_local_number" name="whatsapp_local_number" required placeholder="e.g. 8012345678" value="<%= values.whatsapp_local_number || '' %>" style="flex:1" />
        </div>
        <span class="hint">Pick your WhatsApp number's country code, then enter the rest of the number (drop the leading 0).</span>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="country">Country</label>
          <select id="country" name="country" required>
            <% countries.forEach(function(c) { %>
              <option value="<%= c %>" <%= (values.country || 'Nigeria') === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="state">State / Region</label>
          <input id="state" name="state" placeholder="e.g. Lagos" value="<%= values.state || '' %>" />
        </div>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required minlength="8" />
        <span class="hint">At least 8 characters.</span>
      </div>
      <div class="field">
        <label for="password_confirm">Retype password</label>
        <input id="password_confirm" name="password_confirm" type="password" required minlength="8" />
      </div>

      <button type="submit" class="auth-submit">Create account</button>
    </form>

    <script>
      // Instant feedback via the browser's own validity UI — no round trip needed for a
      // typo, though the server checks the match too (never trust client-only validation).
      (function () {
        var pw = document.getElementById('password');
        var confirm = document.getElementById('password_confirm');
        function check() {
          confirm.setCustomValidity(confirm.value && confirm.value !== pw.value ? "Passwords don't match." : '');
        }
        pw.addEventListener('input', check);
        confirm.addEventListener('input', check);
      })();
    </script>

    <div class="auth-switch">Already have an account? <a href="/login">Log in</a></div>
  </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
