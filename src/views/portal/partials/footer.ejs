          <li><a href="/pathways?category=study">Study Abroad</a></li>
          <li><a href="/pathways?category=work">Work Abroad</a></li>
          <li><a href="/pathways?category=family">Family Migration</a></li>
          <li><a href="/#programs">Popular Destinations</a></li>
