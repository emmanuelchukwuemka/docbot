      <div class="f-news">
        <h5>Subscribe to Newsletter</h5>
        <p>Get the latest updates and opportunities straight to your inbox.</p>
        <div class="news-row">
          <input type="email" class="news-input" id="news-email" placeholder="Enter your email" aria-label="Newsletter email" />
          <button class="btn-sub" id="btn-sub" type="button">Subscribe</button>
