</footer>

<script>
  // Newsletter — same client-side-only validation as the homepage's copy of this footer today
  // (no real subscription backend exists yet on either). Not wired to a mailing list.
  (function () {
    var btn = document.getElementById('btn-sub');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var el = document.getElementById('news-email');
      if (el.value && /\S+@\S+\.\S+/.test(el.value)) {
        el.value = '';
        el.placeholder = '✓ Subscribed! Thank you.';
        setTimeout(function () { el.placeholder = 'Enter your email'; }, 3000);
      } else {
        el.style.borderColor = '#ef4444';
        el.placeholder = 'Enter a valid email';
        setTimeout(function () { el.style.borderColor = ''; el.placeholder = 'Enter your email'; }, 2500);
      }
    });
  })();
</script>
