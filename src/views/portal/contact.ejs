<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Contact Us — MigraTech</title>
<meta name="description" content="Get in touch with MigraTech — chat on WhatsApp, or send a message straight to our team." />
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
<style>
.contact-header { position: relative; overflow: hidden; background: #F9FAFB; padding: 68px 0 56px; text-align: center; }
.contact-header::before {
  content: ""; position: absolute; top: -160px; left: 50%; transform: translateX(-50%);
  width: 700px; height: 460px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(0,177,64,0.14) 0%, transparent 70%);
}
.contact-header .container { position: relative; }
.contact-ring { position: absolute; border: 1.5px dashed rgba(0,177,64,0.28); border-radius: 50%; pointer-events: none; }
.contact-ring.r1 { width: 90px; height: 90px; top: 14px; left: 8%; }
.contact-ring.r2 { width: 46px; height: 46px; bottom: 6px; right: 10%; border-style: solid; border-width: 1.5px; opacity: 0.6; }
.contact-dot-fx { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: #00B140; opacity: 0.5; pointer-events: none; }
.contact-dot-fx.d1 { top: 30px; right: 14%; }
.contact-dot-fx.d2 { bottom: 40px; left: 12%; }
.contact-eyebrow {
  display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 100px;
  background: #e8f7ee; border: 1px solid rgba(0,177,64,0.3);
  font-size: 12.5px; font-weight: 700; color: #007a2e; margin-bottom: 20px;
}
.contact-header h1 { font-size: clamp(30px, 4.2vw, 46px); font-weight: 900; color: #0B1E3F; letter-spacing: -0.035em; margin-bottom: 18px; max-width: 700px; margin-left: auto; margin-right: auto; line-height: 1.18; }
.contact-header p { font-size: 15px; color: #6B7280; max-width: 560px; margin: 0 auto; line-height: 1.7; }
.contact-prompts { font-size: 14.5px; color: #6B7280; max-width: 640px; margin: 0 auto 8px; line-height: 1.9; }
.contact-tagline { font-size: 15.5px; font-weight: 700; color: #0B1E3F; margin-top: 4px; }
.contact-body { padding: 72px 0 0; max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
.contact-footnote { padding: 40px 0 90px; text-align: center; }
.contact-options { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
.contact-card {
  background: #fff; border: 1px solid #e5e7eb; border-radius: 24px; padding: 40px 36px;
  box-shadow: 0 2px 8px rgba(11,30,63,0.04), 0 16px 40px rgba(11,30,63,0.07);
  position: relative; overflow: hidden;
  transition: box-shadow 250ms, transform 250ms;
}
.contact-card:hover { transform: translateY(-3px); box-shadow: 0 2px 8px rgba(11,30,63,0.05), 0 24px 56px rgba(11,30,63,0.11); }
.contact-card h2 { font-size: 20px; font-weight: 800; color: #0B1E3F; letter-spacing: -0.01em; }
.contact-card h2 .accent { color: #00B140; }
.contact-card-divider { width: 44px; height: 3px; background: #00B140; border-radius: 2px; }

/* Primary (WhatsApp) card — soft mint panel with an illustrated icon hero, same visual
   language as the About Us section (dots, gradient, divider) instead of a generic white box
   sized to match the form card. Sized to its own natural content — no forced equal-height
   trick that just relocates the whitespace instead of removing it. */
.contact-card--primary {
  background: linear-gradient(160deg, #F3FBF6 0%, #E7F7EC 100%);
  border: 1px solid #DCF2E3; text-align: center;
  box-shadow: 0 2px 8px rgba(0,145,58,0.05), 0 16px 40px rgba(0,145,58,0.1);
}
.contact-card--primary:hover { box-shadow: 0 2px 8px rgba(0,145,58,0.06), 0 24px 56px rgba(0,145,58,0.16); }
.contact-card--primary .contact-card-top { display: flex; flex-direction: column; align-items: center; }
.contact-card--primary p { font-size: 14px; color: #4B5563; line-height: 1.8; margin-top: 16px; max-width: 320px; }
.contact-card--primary .contact-card-divider { margin: 12px auto 0; }
.contact-wa-hero { position: relative; width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }
.contact-wa-ring { position: absolute; inset: 0; border-radius: 50%; border: 1.5px dashed rgba(0,177,64,0.32); animation: contactSpin 40s linear infinite; }
.contact-wa-glow {
  position: absolute; inset: 12px; border-radius: 50%;
  background: radial-gradient(circle, rgba(0,177,64,0.20) 0%, rgba(0,177,64,0.05) 70%, transparent 100%);
}
.contact-wa-pulse {
  position: absolute; inset: 22px; border-radius: 50%; background: rgba(0,177,64,0.25);
  animation: contactPulse 2.4s cubic-bezier(0,0,0.2,1) infinite;
}
@keyframes contactPulse { 0% { transform: scale(0.85); opacity: 0.6; } 100% { transform: scale(1.35); opacity: 0; } }
@keyframes contactSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.contact-wa-bubble {
  position: relative; z-index: 2; width: 74px; height: 74px; border-radius: 50%;
  background: linear-gradient(155deg, #00CC4E 0%, #00913A 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12px 28px rgba(0,177,64,0.4);
}
.contact-wa-bubble svg { width: 33px; height: 33px; color: #fff; }
.contact-wa-live {
  position: absolute; z-index: 3; bottom: 2px; right: 2px; width: 20px; height: 20px; border-radius: 50%;
  background: #22C55E; border: 3px solid #F3FBF6; display: flex; align-items: center; justify-content: center;
}
.contact-wa-dot { position: absolute; border-radius: 50%; background: #00B140; }
.contact-wa-dot.d1 { width: 8px; height: 8px; top: 2px; left: 6px; }
.contact-wa-dot.d2 { width: 10px; height: 10px; bottom: 16px; right: -2px; opacity: 0.55; }
.contact-wa-ring2 { position: absolute; width: 12px; height: 12px; border: 1.5px solid rgba(0,177,64,0.45); border-radius: 50%; top: 8px; right: 16px; }
.contact-wa-btn {
  display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 14.5px; font-weight: 700; color: #fff;
  background: #00B140; padding: 14px 26px; border-radius: 12px; width: 100%;
  box-shadow: 0 8px 20px rgba(0,177,64,0.32); transition: background 150ms, box-shadow 150ms, transform 150ms;
  margin-top: 28px;
}
.contact-wa-btn:hover { background: #009935; box-shadow: 0 10px 26px rgba(0,177,64,0.42); transform: translateY(-2px); }
.contact-facts { display: flex; justify-content: center; gap: 28px; margin-top: 24px; padding-top: 22px; border-top: 1px solid #DCF2E3; }
.contact-fact { text-align: center; }
.contact-fact-ico {
  width: 34px; height: 34px; border-radius: 50%; background: #fff; border: 1px solid #DCF2E3;
  display: flex; align-items: center; justify-content: center; color: #00B140; margin: 0 auto 8px;
}
.contact-fact-ico svg { width: 15px; height: 15px; }
.contact-fact-num { font-size: 14.5px; font-weight: 800; color: #0B1E3F; }
.contact-fact-lbl { font-size: 11.5px; color: #6B7280; margin-top: 1px; }
.contact-card--primary .contact-dots {
  position: absolute; bottom: 20px; left: 24px; width: 66px; height: 46px;
  background-image: radial-gradient(circle, rgba(0,177,64,0.28) 1.5px, transparent 1.5px);
  background-size: 12px 12px; opacity: 0.7;
}
.contact-card--primary::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 46px; pointer-events: none;
  background: linear-gradient(180deg, transparent 0%, rgba(0,177,64,0.10) 100%);
}

/* Message form card — left-aligned, functional */
.contact-card--form { text-align: left; }
.contact-form-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 6px; }
.contact-card-icon {
  width: 52px; height: 52px; border-radius: 13px; flex: none; display: flex; align-items: center; justify-content: center;
  background: #e8f7ee; color: #00B140;
}
.contact-card-icon svg { width: 24px; height: 24px; }
.contact-form-head .contact-card-divider { margin-top: 8px; }
.contact-card--form > p { font-size: 14px; color: #6B7280; line-height: 1.75; max-width: 480px; margin: 20px 0 30px; }
.contact-form { text-align: left; }
.contact-form .field-input-wrap { position: relative; }
.contact-form .field-icon {
  position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
  color: #00B140; display: flex; pointer-events: none;
}
.contact-form .field-input-wrap.is-textarea .field-icon { top: 15px; transform: none; }
.contact-form .field-input-wrap input, .contact-form .field-input-wrap textarea { padding-left: 38px; }
.contact-form-note { background: #F9FAFB; border-radius: 8px; padding: 10px 12px; font-size: 12.5px; color: #6B7280; margin-bottom: 16px; }
.contact-form-note b { color: #0B1E3F; }
.contact-sent { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 0; text-align: center; }
.contact-sent-icon { width: 48px; height: 48px; border-radius: 50%; background: #ecfdf5; color: #059669; display: flex; align-items: center; justify-content: center; }
.contact-form .auth-submit { display: flex; align-items: center; justify-content: center; gap: 9px; }
.contact-privacy-note {
  display: flex; align-items: flex-start; gap: 10px; margin-top: 18px;
  background: #F0FBF4; border: 1px solid #DCF2E3; border-radius: 10px; padding: 12px 14px;
}
.contact-privacy-note svg { width: 18px; height: 18px; color: #00B140; flex: none; margin-top: 1px; }
.contact-privacy-note p { font-size: 12px; color: #4B5563; line-height: 1.6; margin: 0; }

/* Departments — full-bleed dark band, matching the landing page's own dark feature bar, so
   this page gets the same light/dark rhythm the rest of the site has instead of staying flat
   and pastel top to bottom. */
.contact-depts-band { background: #0B1E3F; padding: 68px 0; margin-top: 76px; position: relative; overflow: hidden; }
.contact-depts-band::before {
  content: ""; position: absolute; top: -200px; left: 50%; transform: translateX(-50%);
  width: 800px; height: 400px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(0,177,64,0.18) 0%, transparent 70%);
}
.contact-depts-head {
  position: relative; text-align: center; font-size: 12.5px; font-weight: 800; color: rgba(255,255,255,0.45); text-transform: uppercase;
  letter-spacing: 0.08em; margin: 0 0 28px;
}
.contact-depts { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.contact-dept {
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;
  padding: 24px 18px; text-align: center;
  transition: box-shadow 200ms, transform 200ms, border-color 200ms, background 200ms;
}
.contact-dept:hover { transform: translateY(-4px); background: rgba(255,255,255,0.07); border-color: rgba(0,177,64,0.4); }
.contact-dept-icon {
  width: 38px; height: 38px; border-radius: 10px; background: rgba(0,177,64,0.16); border: 1px solid rgba(0,177,64,0.3); color: #4ADE80;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;
}
.contact-dept-icon svg { width: 17px; height: 17px; }
.contact-dept-label {
  font-size: 11px; font-weight: 800; color: rgba(255,255,255,0.45); text-transform: uppercase;
  letter-spacing: 0.05em; margin-bottom: 8px;
}
.contact-dept-email { font-size: 13.5px; font-weight: 700; color: #fff; word-break: break-all; transition: color 120ms; }
.contact-dept-email:hover { color: #4ADE80; }

/* Entrance motion — the two cards fade up on load (they're above the fold), the dept cards
   fade up on scroll since they sit lower on the page. */
@keyframes contactFadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
.contact-card { animation: contactFadeUp 640ms cubic-bezier(.2,.7,.3,1) both; }
.contact-card--primary { animation-delay: 40ms; }
.contact-card--form { animation-delay: 140ms; }
.contact-dept.reveal { opacity: 0; transform: translateY(20px); transition: opacity 550ms ease, transform 550ms ease; }
.contact-dept.reveal.in-view { opacity: 1; transform: translateY(0); }
@media (prefers-reduced-motion: reduce) {
  .contact-card, .contact-dept.reveal, .contact-wa-ring, .contact-wa-pulse { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
}

@media (max-width: 800px) {
  .contact-options { grid-template-columns: 1fr; }
  .contact-card { height: auto; }
  .contact-depts { grid-template-columns: repeat(2, 1fr); }
}
</style>
</head>
<body>

<%- include('partials/nav') %>

<header class="contact-header">
  <div class="contact-ring r1" aria-hidden="true"></div>
  <div class="contact-ring r2" aria-hidden="true"></div>
  <div class="contact-dot-fx d1" aria-hidden="true"></div>
  <div class="contact-dot-fx d2" aria-hidden="true"></div>
  <div class="container">
    <div class="contact-eyebrow">Contact</div>
    <h1>Your next chapter could start with a conversation.</h1>
    <p class="contact-prompts">Have a question about migrating? Looking for a pathway? Interested in partnering with us? Need expert support?</p>
    <p class="contact-tagline">We're here to help.</p>
  </div>
</header>

<div class="contact-body">
  <div class="contact-options">

    <!-- WhatsApp -->
    <div class="contact-card contact-card--primary">
      <div class="contact-dots" aria-hidden="true"></div>
      <div class="contact-card-top">
        <div class="contact-wa-hero" aria-hidden="true">
          <div class="contact-wa-ring"></div>
          <div class="contact-wa-glow"></div>
          <div class="contact-wa-pulse"></div>
          <div class="contact-wa-dot d1"></div>
          <div class="contact-wa-dot d2"></div>
          <div class="contact-wa-ring2"></div>
          <div class="contact-wa-bubble">
            <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.44 1.32 4.93L2.05 22l5.3-1.39a9.9 9.9 0 004.69 1.19h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0012.04 2z"/></svg>
            <div class="contact-wa-live"></div>
          </div>
        </div>
        <h2>Talk to <span class="accent">Migra</span></h2>
        <div class="contact-card-divider" aria-hidden="true"></div>
        <p>Start a conversation with our Migration Concierge on WhatsApp and tell us where you want to go, what you want to achieve and where you are in your journey.</p>
      </div>
      <div>
        <a href="https://wa.me/2348153955718" target="_blank" rel="noopener" class="contact-wa-btn">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.44 1.32 4.93L2.05 22l5.3-1.39a9.9 9.9 0 004.69 1.19h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0012.04 2z"/></svg>
          Chat on WhatsApp →
        </a>
        <div class="contact-facts">
          <div class="contact-fact">
            <div class="contact-fact-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3.5 2"/></svg></div>
            <div class="contact-fact-num">24/7</div>
            <div class="contact-fact-lbl">Available</div>
          </div>
          <div class="contact-fact">
            <div class="contact-fact-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <div class="contact-fact-num">Real people</div>
            <div class="contact-fact-lbl">Not just AI</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Direct message -->
    <div class="contact-card contact-card--form">
      <div>
        <div class="contact-form-head">
          <div class="contact-card-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <h2>Message <span class="accent">Our Team</span></h2>
            <div class="contact-card-divider" aria-hidden="true"></div>
          </div>
        </div>
        <p>Prefer not to use WhatsApp? Send a message here and our team will get back to you by email.</p>

        <% if (sent) { %>
          <div class="contact-sent">
            <div class="contact-sent-icon"><svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div>
            <p style="font-size:14px;color:#374151">Message sent — we'll get back to you soon.</p>
          </div>
        <% } else { %>
          <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>
          <form method="post" action="/contact/message" class="contact-form">
            <% if (sessionUser) { %>
              <div class="contact-form-note">Sending as <b><%= sessionUser.name || 'you' %></b> (<%= sessionUser.email || sessionUser.whatsapp_number %>)</div>
            <% } else { %>
              <div class="field">
                <label>Your name</label>
                <div class="field-input-wrap">
                  <span class="field-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.5 21a6.5 6.5 0 0113 0"/></svg></span>
                  <input name="name" required placeholder="Enter your full name" value="<%= values.name || '' %>" />
                </div>
              </div>
              <div class="field">
                <label>Email (so we can reply)</label>
                <div class="field-input-wrap">
                  <span class="field-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></span>
                  <input name="email" type="email" placeholder="Enter your email address" value="<%= values.email || '' %>" />
                </div>
              </div>
            <% } %>
            <div class="field">
              <label>Message</label>
              <div class="field-input-wrap is-textarea">
                <span class="field-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20h9"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></span>
                <textarea name="message" rows="8" required placeholder="How can we help?"><%= values.message || '' %></textarea>
              </div>
            </div>
            <button type="submit" class="auth-submit">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2 11 13"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2 15 22 11 13 2 9 22 2Z"/></svg>
              Send Message
            </button>
            <div class="contact-privacy-note">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2 4 5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V5l-8-3z"/></svg>
              <p>We respect your privacy. Your information is safe with us and will only be used to respond to your inquiry.</p>
            </div>
          </form>
        <% } %>
      </div>
    </div>

  </div>
</div>

<section class="contact-depts-band" aria-label="Reach the right team">
  <div class="container">
    <div class="contact-depts-head">Reach the Right Team</div>
    <div class="contact-depts">
      <div class="contact-dept reveal">
        <div class="contact-dept-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
        <div class="contact-dept-label">General Enquiries</div>
        <a href="mailto:hello@migra.ng" class="contact-dept-email">hello@migra.ng</a>
      </div>
      <div class="contact-dept reveal" style="transition-delay:80ms">
        <div class="contact-dept-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <div class="contact-dept-label">Partnerships</div>
        <a href="mailto:partnerships@migra.ng" class="contact-dept-email">partnerships@migra.ng</a>
      </div>
      <div class="contact-dept reveal" style="transition-delay:160ms">
        <div class="contact-dept-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2 4 5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V5l-8-3z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg></div>
        <div class="contact-dept-label">Support</div>
        <a href="mailto:support@migra.ng" class="contact-dept-email">support@migra.ng</a>
      </div>
      <div class="contact-dept reveal" style="transition-delay:240ms">
        <div class="contact-dept-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg></div>
        <div class="contact-dept-label">Careers</div>
        <a href="mailto:careers@migra.ng" class="contact-dept-email">careers@migra.ng</a>
      </div>
    </div>
  </div>
</section>

<div class="contact-footnote">
  <p style="text-align:center;font-size:13px;color:#9CA3AF">
    <% if (!sessionUser) { %>Already a client? <a href="/login" style="color:#00B140;font-weight:700">Log in to your account</a> to check your applications, documents and payments.<% } %>
  </p>
</div>

<%- include('partials/footer') %>

<script>
  (function contactDeptReveal() {
    var targets = document.querySelectorAll('.contact-dept.reveal');
    if (!targets.length || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });
    targets.forEach(function (el) { io.observe(el); });
  })();
</script>

</body>
</html>
