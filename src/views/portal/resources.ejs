<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Resources — MigraTech</title>
<meta name="description" content="Migration decisions deserve better information. Guides, country information, blog and FAQs to help you make informed decisions about moving abroad." />
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
<style>
.resources-header {
  position: relative; overflow: hidden;
  background-image: url('/resources-hero.png');
  background-size: cover; background-position: center 30%;
  padding: 88px 0;
}
.resources-header::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(90deg, #F9FAFB 0%, #F9FAFB 22%, rgba(249,250,251,0.88) 36%, rgba(249,250,251,0.35) 52%, rgba(249,250,251,0) 66%);
}
.resources-header .container { position: relative; max-width: 1180px; }
.resources-eyebrow {
  display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 100px;
  background: #e8f7ee; border: 1px solid rgba(0,177,64,0.3);
  font-size: 12.5px; font-weight: 700; color: #007a2e; margin-bottom: 20px;
}
.resources-header h1 { font-size: clamp(34px, 4.6vw, 52px); font-weight: 900; color: #0B1E3F; letter-spacing: -0.035em; line-height: 1.08; margin-bottom: 18px; }
.resources-header h1 .accent { color: #00B140; }
.resources-header p { font-size: 16px; color: #4B5563; max-width: 460px; line-height: 1.75; }
@media (max-width: 900px) {
  .resources-header { background-position: center 15%; min-height: 0; }
  .resources-header::before { background: linear-gradient(180deg, rgba(249,250,251,0.5) 0%, #F9FAFB 58%, #F9FAFB 100%); }
  .resources-header .container { padding: 220px 20px 44px; }
  .resources-header p { max-width: 100%; }
}

.resources-body { padding: 76px 0 0; background: #fff; }
.resources-section-head { font-size: 26px; font-weight: 900; color: #0B1E3F; letter-spacing: -0.02em; margin-bottom: 26px; }

.resources-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
.resource-card {
  background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 18px; padding: 28px 24px;
  display: flex; flex-direction: column;
  transition: box-shadow 200ms, transform 200ms, border-color 200ms;
}
.resource-card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px rgba(0,0,0,0.07); border-color: #d8dde3; }
.resource-ico {
  width: 46px; height: 46px; border-radius: 13px;
  display: flex; align-items: center; justify-content: center; margin-bottom: 18px;
}
.resource-ico svg { width: 21px; height: 21px; }
.resource-ico.c-green  { background: #E8F7EE; color: #00B140; }
.resource-ico.c-blue   { background: #E8F0FE; color: #2563EB; }
.resource-ico.c-purple { background: #F1EAFE; color: #7C3AED; }
.resource-ico.c-amber  { background: #FEF3E2; color: #D97706; }
.resource-ico.c-teal   { background: #E1F7F5; color: #0D9488; }
.resource-card h2 { font-size: 17px; font-weight: 800; color: #0B1E3F; margin-bottom: 8px; }
.resource-card > p { font-size: 13px; color: #6B7280; line-height: 1.7; margin-bottom: 16px; }
.resource-checklist { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-direction: column; gap: 7px; }
.resource-checklist li { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: #374151; }
.resource-checklist svg { width: 14px; height: 14px; color: #00B140; flex: none; }
.resource-link { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; }
.resource-link:hover { text-decoration: underline; }
.resource-link.c-green  { color: #00B140; }
.resource-link.c-blue   { color: #2563EB; }
.resource-link.c-purple { color: #7C3AED; }
.resource-link.c-amber  { color: #D97706; }
.resource-link.c-teal   { color: #0D9488; }
.resource-badge-soon {
  align-self: flex-start; font-size: 10px; font-weight: 800; color: #92400E; background: #FEF3C7;
  padding: 4px 10px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px;
}

.goals-section { margin: 60px 0 0; background: #F9FAFB; border-radius: 24px; padding: 44px 40px; }
.goals-head h2 { font-size: 22px; font-weight: 900; color: #0B1E3F; margin-bottom: 6px; }
.goals-head p { font-size: 14px; color: #6B7280; margin-bottom: 32px; }
.goals-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
.goal-item .goal-ico { width: 40px; height: 40px; border-radius: 11px; background: #fff; border: 1px solid #E5E7EB; display: flex; align-items: center; justify-content: center; color: #00B140; margin-bottom: 16px; }
.goal-item .goal-ico svg { width: 19px; height: 19px; }
.goal-item h3 { font-size: 15.5px; font-weight: 800; color: #0B1E3F; margin-bottom: 6px; }
.goal-item p { font-size: 12.5px; color: #6B7280; line-height: 1.6; margin-bottom: 12px; }
.goal-item a { display: inline-flex; color: #00B140; }
.goal-item a svg { width: 17px; height: 17px; }

.resources-disclaimer {
  margin: 44px 0 76px; display: flex; align-items: flex-start; gap: 14px;
  background: #0B1E3F; border-radius: 16px; padding: 22px 26px;
}
.resources-disclaimer .disc-ico {
  width: 34px; height: 34px; border-radius: 10px; background: rgba(0,177,64,0.18); color: #3ddc84;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.resources-disclaimer .disc-ico svg { width: 18px; height: 18px; }
.resources-disclaimer p { font-size: 13.5px; color: #CBD5E1; line-height: 1.7; margin: 0; }
.resources-disclaimer p b { color: #fff; }

@media (max-width: 1000px) {
  .resources-grid { grid-template-columns: repeat(2, 1fr); }
  .goals-grid { grid-template-columns: repeat(2, 1fr); }
  .goals-section { padding: 34px 26px; }
}
@media (max-width: 620px) {
  .resources-grid { grid-template-columns: 1fr; }
  .goals-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<%- include('partials/nav') %>

<header class="resources-header" role="img" aria-label="A traveler holding a boarding pass and passport, backpack on shoulder, city skyline behind her">
  <div class="container">
    <div class="resources-eyebrow">Resources</div>
    <h1>Know more.<br>Move <span class="accent">smarter.</span></h1>
    <p>Migration decisions deserve better information. Our resource centre gives you practical, accessible information to help you make informed decisions about moving abroad.</p>
  </div>
</header>

<div class="resources-body">
  <div class="container">
    <div class="resources-section-head">Explore our resources</div>
    <div class="resources-grid">

      <div class="resource-card">
        <div class="resource-ico c-green"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.25C10.5 5 8.5 4 6 4a5.5 5.5 0 000 11c2 0 3.5.5 6 2.25m0-11C13.5 5 15.5 4 18 4a5.5 5.5 0 010 11c-2 0-3.5.5-6 2.25m0-11v11"/></svg></div>
        <h2>Migration Guides</h2>
        <p>Practical guides to help you every step of the way.</p>
        <ul class="resource-checklist">
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Work migration</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Study migration</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Family migration</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Visa pathways</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Documentation</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Job searches</li>
          <li><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>Settlement</li>
        </ul>
        <a href="/guides" class="resource-link c-green">Explore Guides →</a>
      </div>

      <div class="resource-card">
        <div class="resource-ico c-blue"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9z"/></svg></div>
        <h2>Country Guides</h2>
        <p>Understand migration opportunities and considerations across different destinations.</p>
        <a href="/countries" class="resource-link c-blue" style="margin-top:auto">Explore Countries →</a>
      </div>

      <div class="resource-card">
        <div class="resource-badge-soon">Coming Soon</div>
        <div class="resource-ico c-purple"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h8M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg></div>
        <h2>Migration Calculator</h2>
        <p>Estimate potential migration-related costs and plan your finances with confidence. We're building this out — check back soon.</p>
      </div>

      <div class="resource-card">
        <div class="resource-ico c-amber"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z"/></svg></div>
        <h2>Migra Blog</h2>
        <p>Insights, updates, opportunities and expert perspectives on migration and global opportunities.</p>
        <a href="/blog" class="resource-link c-amber" style="margin-top:auto">Read the Blog →</a>
      </div>

      <div class="resource-card">
        <div class="resource-ico c-teal"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.5 9a2.5 2.5 0 015 .5c0 1.5-2.5 1.8-2.5 3.5M12 17h.01"/></svg></div>
        <h2>Frequently Asked Questions</h2>
        <p>Find answers to the questions Africans ask most about moving abroad.</p>
        <a href="/#faqs" class="resource-link c-teal" style="margin-top:auto">Visit FAQs →</a>
      </div>

    </div>

    <div class="goals-section">
      <div class="goals-head">
        <h2>Explore by your goal</h2>
        <p>Different journeys. Different goals. We've got you covered.</p>
      </div>
      <div class="goals-grid">

        <div class="goal-item">
          <div class="goal-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2M3 12h18"/></svg></div>
          <h3>Work Abroad</h3>
          <p>Find jobs, visas and pathways to build your career abroad.</p>
          <a href="/pathways?category=work" aria-label="Explore Work Abroad pathways"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="goal-item">
          <div class="goal-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.42A9 9 0 0112 21a9 9 0 01-6.16-10.42L12 14z"/></svg></div>
          <h3>Study Abroad</h3>
          <p>Explore schools, visas and scholarships to achieve your goals.</p>
          <a href="/pathways?category=study" aria-label="Explore Study Abroad pathways"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="goal-item">
          <div class="goal-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="7" r="3" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 21v-1a6 6 0 016-6h2a6 6 0 016 6v1"/><circle cx="17.5" cy="8.5" r="2.3" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-1a5 5 0 015-5"/></svg></div>
          <h3>Family Migration</h3>
          <p>Bring your loved ones closer and build a better life together.</p>
          <a href="/pathways?category=family" aria-label="Explore Family Migration pathways"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="goal-item">
          <div class="goal-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11l9-8 9 8M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"/></svg></div>
          <h3>Relocate</h3>
          <p>Plan your move and settle comfortably in your new home.</p>
          <a href="/#plans" aria-label="See Migra Relocate plan"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

      </div>
    </div>

    <div class="resources-disclaimer">
      <div class="disc-ico"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/></svg></div>
      <p><b>Important:</b> Migration policies and requirements change. Always verify critical requirements against the relevant official government authority or qualified professional.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
