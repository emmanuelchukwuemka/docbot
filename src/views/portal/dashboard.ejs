<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>My Account — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%
  var initials = (user.name || 'M T').trim().split(/\s+/).slice(0, 2).map(function(w){ return w[0]; }).join('').toUpperCase();
  var pendingDocs = documents.filter(function(d){ return d.verification_status === 'unreviewed'; }).length;
  var paidPayments = payments.filter(function(p){ return p.status === 'paid'; });
  var paidTotal = paidPayments.reduce(function(sum, p){ return sum + p.amount; }, 0);
  var upcomingConsultation = consultations.find(function(c){ return c.status === 'requested' || c.status === 'confirmed'; });
  var radius = 41, circumference = 2 * Math.PI * radius;
  var ringOffset = circumference * (1 - progressPercent / 100);
  var ACTIVITY_ICONS = {
    good: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>',
    bad: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>',
    neutral: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  };
  var CHECKLIST_DOT = {
    missing: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/></svg>',
    uploaded: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9" stroke-width="2"/></svg>',
    under_review: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9" stroke-width="2"/></svg>',
    verified: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>',
    rejected: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>',
  };
%>

<div class="dash-layout">

  <!-- ══════════════ SIDEBAR ══════════════ -->
  <aside class="dash-sidebar">
    <a href="/" class="dash-sidebar-brand" aria-label="MigraTech">
      <img src="/brand/logo-full.png" alt="MigraTech" class="brand-logo" />
    </a>
    <nav class="dash-sidebar-nav" aria-label="Account sections">
      <a href="#overview" data-section="overview" class="active">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 22V12h6v10"/></svg>
        Dashboard
      </a>

      <div class="dash-sidebar-group-label">Journey</div>
      <a href="#profile" data-section="profile">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        My Profile
      </a>
      <a href="#plan" data-section="plan">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        My Migration Plan
      </a>
      <a href="#documents" data-section="documents">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Documents
      </a>
      <a href="#checklist" data-section="checklist">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        Tasks &amp; Checklist
      </a>
      <a href="https://wa.me/2348153955718" target="_blank" rel="noopener">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        Message Us
      </a>

      <div class="dash-sidebar-group-label">Discover</div>
      <a href="/pathways">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
        Migration Pathways
      </a>
      <a href="/countries">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9z"/></svg>
        Countries
      </a>

      <div class="dash-sidebar-group-label">Support</div>
      <a href="#consultation" data-section="consultation">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M8 2v4M16 2v4"/></svg>
        Consultation
      </a>
      <a href="/guides">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20.5a2.5 2.5 0 01-2.5-2.5V6a2.5 2.5 0 015 0v12a2.5 2.5 0 01-2.5 2.5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12H2m20 0h-2.5M6 5.5L4.5 4m15 1.5L18 4M6 18.5L4.5 20m15-1.5L18 20"/></svg>
        Help Center
      </a>
      <a href="/contact">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Contact Support
      </a>
    </nav>

    <div class="dash-sidebar-cta">
      <h5>Need Expert Help?</h5>
      <p>Book a consultation with a migration specialist.</p>
      <a href="#consultation">Book Now</a>
    </div>

    <div class="dash-sidebar-foot">
      <div class="dash-sidebar-user">
        <div class="dash-avatar-sm"><%= initials %></div>
        <div class="who">
          <b><%= user.name || 'there' %></b>
          <span><%= user.email || user.whatsapp_number %></span>
        </div>
      </div>
      <a href="/settings" class="btn-logout" style="display:block;text-align:center;text-decoration:none;margin-bottom:8px">Account Settings</a>
      <form method="post" action="/logout">
        <button type="submit" class="btn-logout">Log out</button>
      </form>
      <a href="/" class="back-home">← Back to migra.ng</a>
    </div>
  </aside>

  <!-- ══════════════ MAIN ══════════════ -->
  <main class="dash-main">
    <div class="dash-topbar">
      <h1>Welcome back, <%= (user.name || 'there').split(' ')[0] %> 👋</h1>
    </div>

    <div class="dash-content">

      <% if (flashMessage) { %><div class="dash-flash success"><%= flashMessage %></div><% } %>
      <% if (flashError) { %><div class="dash-flash error"><%= flashError %></div><% } %>

      <!-- Hero + progress -->
      <div id="overview" class="dash-hero-row">
        <div class="dash-hero">
          <h2>Your Migration Journey</h2>
          <p>Track your applications, documents and next steps here — the conversation itself happens on WhatsApp with our bot and specialists.</p>
          <a href="https://wa.me/2348153955718" target="_blank" rel="noopener" class="btn-wa" style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0B1E3F;padding:10px 20px;border-radius:8px;font-weight:700;font-size:13.5px">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.44 1.32 4.93L2.05 22l5.3-1.39a9.9 9.9 0 004.69 1.19h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0012.04 2z"/></svg>
            Continue on WhatsApp
          </a>
        </div>
        <div class="progress-card">
          <div class="progress-ring-wrap">
            <svg width="92" height="92" viewBox="0 0 92 92">
              <circle class="progress-ring-track" cx="46" cy="46" r="<%= radius %>" />
              <circle class="progress-ring-fill" cx="46" cy="46" r="<%= radius %>" stroke-dasharray="<%= circumference %>" stroke-dashoffset="<%= ringOffset %>" />
            </svg>
            <div class="progress-ring-label"><%= progressPercent %>%</div>
          </div>
          <div class="progress-card-text">
            <h4>Migration Progress</h4>
            <% if (applications.length) { %>
              <p>Your furthest-along application is at the <b><%= applications[0].stageLabel %></b> stage.</p>
            <% } else { %>
              <p>No active application yet — this fills in once you start one on WhatsApp.</p>
            <% } %>
            <a href="#plan">View details →</a>
          </div>
        </div>
      </div>

      <!-- Quick stats -->
      <div class="stat-tiles">
        <div class="stat-tile">
          <div class="stat-tile-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <div>
            <div class="label">Migration Plan</div>
            <div class="value"><%= applications.length %> <span style="font-size:12px;font-weight:600;color:#9CA3AF"><%= applications.length === 1 ? 'Active Plan' : 'Active Plans' %></span></div>
          </div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          </div>
          <div>
            <div class="label">Checklist</div>
            <div class="value"><%= checklistPending %> <span style="font-size:12px;font-weight:600;color:#9CA3AF">Pending</span></div>
          </div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <div class="label">Documents</div>
            <div class="value"><%= documents.length %> <span style="font-size:12px;font-weight:600;color:#9CA3AF">Uploaded</span></div>
            <% if (pendingDocs) { %><div class="sub"><%= pendingDocs %> pending review</div><% } %>
          </div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M8 2v4M16 2v4"/></svg>
          </div>
          <div>
            <div class="label">Consultations</div>
            <div class="value"><%= consultations.length %> <span style="font-size:12px;font-weight:600;color:#9CA3AF"><%= upcomingConsultation ? 'Upcoming' : 'On file' %></span></div>
          </div>
        </div>
      </div>

      <!-- Migration profile -->
      <section id="profile" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <h2>My Profile</h2>
        </div>
        <% if (profile) { %>
          <div class="profile-grid">
            <div class="profile-stat"><div class="label">Destination</div><div class="value"><%= profile.destination_country || '—' %></div></div>
            <div class="profile-stat"><div class="label">Goal</div><div class="value"><%= profile.migration_objective || '—' %></div></div>
            <div class="profile-stat"><div class="label">Timeline</div><div class="value"><%= profile.timeline || '—' %></div></div>
            <div class="profile-stat"><div class="label">Financial readiness</div><div class="value"><%= profile.financial_readiness || '—' %></div></div>
          </div>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            <div class="dash-empty-body">
              <p>No migration profile yet — start a conversation on WhatsApp and we'll build yours as we go.</p>
              <a href="https://wa.me/2348153955718" target="_blank" rel="noopener" class="btn-mini">Start on WhatsApp →</a>
            </div>
          </div>
        <% } %>
      </section>

      <!-- My Migration Plan -->
      <section id="plan" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <h2>My Migration Plan</h2>
        </div>
        <% if (applications.length) { %>
          <div style="display:flex;flex-direction:column;gap:16px">
            <% applications.forEach(function(a) { %>
              <div style="display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid #F0F1F3">
                <div style="flex:1;min-width:0">
                  <div style="font-size:14.5px;font-weight:700;color:#0B1E3F"><%= a.pathwayName ? (a.country + ' — ' + a.pathwayName) : 'Pathway not yet selected' %></div>
                  <div style="display:flex;align-items:center;gap:10px;margin-top:8px">
                    <div style="flex:1;max-width:280px;height:7px;background:#F0F1F3;border-radius:10px;overflow:hidden">
                      <div style="height:100%;width:<%= a.progressPercent %>%;background:#00B140;border-radius:10px"></div>
                    </div>
                    <span style="font-size:12px;color:#6B7280;white-space:nowrap"><%= a.progressPercent %>% · <%= a.stageLabel %></span>
                  </div>
                  <div style="font-size:11.5px;color:#9CA3AF;margin-top:6px">Last updated: <%= new Date(a.updated_at).toLocaleDateString() %></div>
                </div>
                <a href="https://wa.me/2348153955718" target="_blank" rel="noopener" class="btn-mini" style="flex:none">Continue →</a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>
            <div class="dash-empty-body">
              <p>No migration plan yet.</p>
              <a href="https://wa.me/2348153955718" target="_blank" rel="noopener" class="btn-mini">Start on WhatsApp →</a>
            </div>
          </div>
        <% } %>
      </section>

      <div class="dash-grid-2">
        <!-- Latest Updates -->
        <section class="dash-panel">
          <div class="dash-panel-head">
            <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg></div>
            <h2>Latest Updates</h2>
          </div>
          <% if (activity.length) { %>
            <div style="display:flex;flex-direction:column">
              <% activity.forEach(function(e) { %>
                <div class="recent-row" style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid #F0F1F3">
                  <div class="checklist-dot <%= e.kind === 'good' ? 'verified' : (e.kind === 'bad' ? 'rejected' : 'missing') %>" style="margin-top:1px"><%- ACTIVITY_ICONS[e.kind] %></div>
                  <div style="flex:1">
                    <div style="font-size:13px;color:#111"><%= e.text %></div>
                    <div style="font-size:11px;color:#9CA3AF;margin-top:2px"><%= new Date(e.at).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="dash-empty-body" style="font-size:13.5px;color:#6B7280">Nothing to show yet — updates appear here as your case progresses.</p>
          <% } %>
        </section>

        <!-- Upcoming Consultation -->
        <section class="dash-panel">
          <div class="dash-panel-head">
            <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M8 2v4M16 2v4"/></svg></div>
            <h2>Upcoming Consultation</h2>
          </div>
          <% if (upcomingConsultation) { %>
            <div>
              <div style="font-size:15px;font-weight:800;color:#0B1E3F;margin-bottom:6px">Initial Consultation</div>
              <div style="font-size:13px;color:#6B7280;margin-bottom:4px">Preferred time: <%= upcomingConsultation.preferred_time_text %></div>
              <span class="badge <%= upcomingConsultation.status === 'confirmed' ? 'green' : 'amber' %>"><%= upcomingConsultation.status %></span>
            </div>
          <% } else { %>
            <div class="consultation-empty-cta">
              <p style="font-size:13.5px;color:#6B7280;margin-bottom:14px">No consultation booked yet.</p>
              <a href="#consultation" class="btn-mini">Book a consultation →</a>
            </div>
          <% } %>
        </section>
      </div>

      <!-- Recommended Pathways -->
      <section class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>
          <h2>Recommended Pathways For You</h2>
          <a href="/pathways" class="count" style="color:#00B140;font-weight:700;text-decoration:none">Browse all →</a>
        </div>
        <% if (recommendations.length) { %>
          <div class="recommend-grid">
            <% recommendations.forEach(function(r) { %>
              <div class="recommend-card">
                <span class="badge green">Potentially Suitable</span>
                <h4><%= r.country %> — <%= r.name %></h4>
                <% if (r.summary) { %><p style="font-size:12.5px;color:#6B7280;line-height:1.6"><%= r.summary %></p><% } %>
                <ul>
                  <% r.reasons.slice(0, 2).forEach(function(reason) { %><li><%= reason %></li><% }) %>
                </ul>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            <div class="dash-empty-body"><p><%= profile ? "We don't have a confident match for your profile yet — a specialist can help you explore options directly." : "Build your migration profile on WhatsApp and we'll surface pathways that genuinely fit." %></p></div>
          </div>
        <% } %>
      </section>

      <!-- Documents -->
      <section id="documents" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div>
          <h2>Documents</h2>
          <% if (documents.length) { %><span class="count"><%= documents.length %></span><% } %>
        </div>
        <% if (documents.length) { %>
          <table class="dash-table">
            <thead><tr><th>Document</th><th>Verification</th><th>Uploaded</th></tr></thead>
            <tbody>
              <% documents.forEach(function(d) { %>
                <tr>
                  <td><%= d.document_type %></td>
                  <td><% var vClass = d.verification_status === 'verified' ? 'green' : (d.verification_status === 'rejected' ? 'red' : 'amber'); %><span class="badge <%= vClass %>"><%= d.verification_status %></span></td>
                  <td><%= d.uploaded_at ? new Date(d.uploaded_at).toLocaleDateString() : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div>
            <div class="dash-empty-body"><p>Documents you send our WhatsApp bot for review will show up here.</p></div>
          </div>
        <% } %>
      </section>

      <!-- Tasks & Checklist -->
      <section id="checklist" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></div>
          <h2>Tasks &amp; Checklist</h2>
        </div>
        <% if (checklistFor) { %>
          <p style="font-size:12.5px;color:#9CA3AF;margin-bottom:6px">For your <%= checklistFor.country %> — <%= checklistFor.pathway %> application</p>
        <% } %>
        <% if (checklist.length) { %>
          <div>
            <% checklist.forEach(function(item) { %>
              <div class="checklist-row">
                <div class="checklist-dot <%= item.status %>"><%- CHECKLIST_DOT[item.status] || CHECKLIST_DOT.missing %></div>
                <span class="name"><%= item.name %></span>
                <span class="badge <%= item.status === 'verified' ? 'green' : (item.status === 'rejected' ? 'red' : (item.status === 'missing' ? 'grey' : 'amber')) %>"><%= item.status.replace(/_/g, ' ') %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></div>
            <div class="dash-empty-body"><p>Your document checklist appears here once you've selected a migration pathway on WhatsApp.</p></div>
          </div>
        <% } %>
      </section>

      <!-- Payments -->
      <section id="payments" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-9 4h16a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
          <h2>Payments</h2>
          <% if (payments.length) { %><span class="count"><%= payments.length %></span><% } %>
        </div>

        <% if (hasNavigateTier) { %>
          <div class="dash-flash success" style="margin-bottom:16px">✅ Migra Plan unlocked — you have access to specialist consultations.</div>
        <% } else if (paystackConfigured) { %>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:12px;padding:16px 20px;margin-bottom:20px;flex-wrap:wrap">
            <div>
              <div style="font-size:14px;font-weight:800;color:#0B1E3F;margin-bottom:2px">Get Migra Plan</div>
              <div style="font-size:12.5px;color:#6B7280">One-time payment · NGN <%= navigatePriceNgn.toLocaleString() %> · unlocks a specialist consultation</div>
            </div>
            <form method="post" action="/payments/navigate">
              <button type="submit" class="auth-submit" style="width:auto;padding:11px 26px">Pay Now →</button>
            </form>
          </div>
        <% } %>

        <% if (payments.length) { %>
          <table class="dash-table">
            <thead><tr><th>Purpose</th><th>Amount</th><th>Status</th><th>Reference</th><th>Date</th></tr></thead>
            <tbody>
              <% payments.forEach(function(p) { %>
                <tr>
                  <td><%= p.purpose %></td>
                  <td><%= p.currency %> <%= p.amount.toLocaleString() %></td>
                  <td><% var pClass = p.status === 'paid' ? 'green' : (p.status === 'refunded' ? 'red' : (p.status === 'waived' ? 'grey' : 'amber')); %><span class="badge <%= pClass %>"><%= p.status %></span></td>
                  <td><% if (p.reference) { %><code style="font-size:11.5px;color:#6B7280"><%= p.reference %></code><% } else { %>—<% } %></td>
                  <td><%= p.paid_at ? new Date(p.paid_at).toLocaleDateString() : new Date(p.created_at).toLocaleDateString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="dash-empty">
            <div class="dash-empty-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-9 4h16a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
            <div class="dash-empty-body"><p>No payments on file yet.</p></div>
          </div>
        <% } %>
      </section>

      <!-- Consultation booking -->
      <section id="consultation" class="dash-panel">
        <div class="dash-panel-head">
          <div class="dash-panel-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M8 2v4M16 2v4"/></svg></div>
          <h2>Book a Consultation</h2>
        </div>
        <% if (consultations.length) { %>
          <table class="dash-table" style="margin-bottom:20px">
            <thead><tr><th>Preferred time</th><th>Status</th><th>Requested</th></tr></thead>
            <tbody>
              <% consultations.forEach(function(c) { %>
                <tr>
                  <td><%= c.preferred_time_text %></td>
                  <td><span class="badge <%= c.status === 'confirmed' ? 'green' : (c.status === 'cancelled' ? 'red' : 'amber') %>"><%= c.status %></span></td>
                  <td><%= new Date(c.created_at).toLocaleDateString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
        <form method="post" action="/consultation" class="consultation-form" style="max-width:480px">
          <div class="field">
            <label>Preferred time (day/date and time that works for you)</label>
            <input name="preferred_time_text" required placeholder="e.g. Tuesday afternoon, or 3 Sept 2pm WAT" />
          </div>
          <div class="field">
            <label>Contact email</label>
            <input name="contact_email" type="email" value="<%= user.email || '' %>" />
          </div>
          <button type="submit" class="auth-submit" style="width:auto;padding:11px 26px">Request Consultation</button>
        </form>
      </section>

    </div>
  </main>
</div>

<script>
  // Scrollspy — highlights the sidebar link for whichever section is currently in view.
  // Click also sets active immediately and scrolls manually (accounting for the sticky
  // topbar) — on a short page there's barely anything to scroll, so waiting on
  // IntersectionObserver alone made clicks look inert.
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.dash-sidebar-nav a[data-section]'));
    var sections = links
      .map(function (link) { return document.getElementById(link.dataset.section); })
      .filter(Boolean);
    if (!sections.length) return;

    function setActive(id) {
      links.forEach(function (link) {
        link.classList.toggle('active', link.dataset.section === id);
      });
    }

    links.forEach(function (link) {
      link.addEventListener('click', function (e) {
        var target = document.getElementById(link.dataset.section);
        if (!target) return;
        e.preventDefault();
        setActive(link.dataset.section);
        var topbar = document.querySelector('.dash-topbar');
        var offset = (topbar ? topbar.offsetHeight : 0) + 20;
        var top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
        history.replaceState(null, '', '#' + link.dataset.section);
      });
    });

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          setActive(entry.target.id);
        });
      },
      { rootMargin: '-84px 0px -70% 0px', threshold: 0 }
    );
    sections.forEach(function (s) { io.observe(s); });
  })();
</script>

</body>
</html>
