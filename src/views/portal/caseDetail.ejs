<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Your Case — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
<style>
.cd-wrap { max-width: 720px; margin: 0 auto; padding: 44px 20px 90px; }
.cd-back { font-size: 13px; color: #6B7280; margin-bottom: 18px; display: inline-block; }
.cd-panel { background: #fff; border: 1px solid #E5E7EB; border-radius: 18px; padding: 26px 28px; margin-bottom: 20px; }
.cd-panel h2 { font-size: 17px; font-weight: 800; color: #0B1E3F; margin-bottom: 14px; }
.cd-info { display: flex; gap: 24px; flex-wrap: wrap; }
.cd-info-item .label { font-size: 11px; color: #9CA3AF; text-transform: uppercase; letter-spacing: 0.05em; }
.cd-info-item .val { font-size: 14px; font-weight: 700; color: #0B1E3F; margin-top: 2px; }
.cd-no-agent { text-align: center; color: #6B7280; font-size: 13.5px; padding: 30px 10px; }
.cd-thread { display: flex; flex-direction: column; gap: 10px; max-height: 420px; overflow-y: auto; padding: 4px 4px 14px; margin-bottom: 14px; }
.cd-bubble { max-width: 70%; padding: 10px 14px; border-radius: 12px; font-size: 13.5px; line-height: 1.5; }
.cd-bubble .meta { font-size: 10.5px; opacity: 0.65; margin-top: 4px; }
.cd-bubble.user { align-self: flex-end; background: #00B140; color: #fff; border-bottom-right-radius: 3px; }
.cd-bubble.vendor { align-self: flex-start; background: #F9FAFB; border: 1px solid #E5E7EB; border-bottom-left-radius: 3px; }
.cd-thread-empty { text-align: center; color: #9CA3AF; font-size: 13px; padding: 24px 0; }
.cd-msg-form { display: flex; gap: 10px; }
.cd-msg-form textarea { flex: 1; resize: none; }
</style>
</head>
<body>

<%- include('partials/nav') %>

<div class="cd-wrap">
  <a href="/dashboard#plan" class="cd-back">← Back to dashboard</a>

  <div class="cd-panel">
    <h2><%= caseData.pathway %></h2>
    <div class="cd-info">
      <div class="cd-info-item"><div class="label">Stage</div><div class="val"><%= caseData.stageLabel %></div></div>
      <div class="cd-info-item"><div class="label">Status</div><div class="val"><%= caseData.status %></div></div>
      <% if (caseData.agent) { %>
        <div class="cd-info-item"><div class="label">Your Agent</div><div class="val"><%= caseData.agent.name %><% if (caseData.agent.business_name) { %> · <%= caseData.agent.business_name %><% } %></div></div>
      <% } %>
    </div>
  </div>

  <div class="cd-panel">
    <h2>Messages</h2>
    <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>

    <% if (!caseData.agent) { %>
      <div class="cd-no-agent">No agent has been assigned to this case yet. Once MigraTech connects you with a partner agent, you'll be able to message them here.</div>
    <% } else { %>
      <div class="cd-thread" id="thread">
        <% if (!caseData.messages.length) { %>
          <div class="cd-thread-empty">No messages yet — send the first one below.</div>
        <% } %>
        <% caseData.messages.forEach(function(m) { %>
          <div class="cd-bubble <%= m.sender_type %>">
            <%= m.body %>
            <div class="meta"><%= m.sender_type === 'user' ? 'You' : caseData.agent.name %> · <%= new Date(m.created_at).toLocaleString() %></div>
          </div>
        <% }) %>
      </div>
      <form method="post" action="/dashboard/cases/<%= caseData.id %>/messages" class="cd-msg-form">
        <textarea name="body" rows="2" required placeholder="Message <%= caseData.agent.name %>..."></textarea>
        <button type="submit" class="auth-submit" style="width:auto;padding:0 22px">Send</button>
      </form>
    <% } %>
  </div>
</div>

<script>
  (function () {
    var t = document.getElementById('thread');
    if (t) t.scrollTop = t.scrollHeight;
  })();
</script>

<%- include('partials/footer') %>

</body>
</html>
