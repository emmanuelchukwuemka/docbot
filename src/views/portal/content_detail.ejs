<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= item.title %> — MigraTech <%= pageLabel %></title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%- include('partials/nav') %>

<article class="content-article">
  <a href="<%= basePath %>" class="content-article-back">← Back to <%= pageLabel %></a>
  <% if (item.cover_image_url) { %><img class="content-article-cover" src="<%= item.cover_image_url %>" alt="" /><% } %>
  <h1><%= item.title %></h1>
  <div class="content-article-meta">
    <%= item.author || 'MigraTech' %><% if (item.published_at) { %> · <%= new Date(item.published_at).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' }) %><% } %>
  </div>
  <div class="content-article-body">
    <% item.body.split(/\n\s*\n/).forEach(function(para) { %>
      <p><%= para.trim() %></p>
    <% }) %>
  </div>
</article>

<%- include('partials/footer') %>

</body>
</html>
