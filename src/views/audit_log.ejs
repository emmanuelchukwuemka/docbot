<%- include('partials/head') %>

<div class="panel">
  <table>
    <tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th><th>Details</th></tr>
    <% entries.forEach(e => { %>
      <tr>
        <td class="muted"><%= new Date(e.created_at).toLocaleString() %></td>
        <td><%= e.actor %></td>
        <td><%= e.action %></td>
        <td><%= e.target_type %><% if (e.target_id) { %> (<%= e.target_id.slice(0,8) %>)<% } %></td>
        <td class="muted"><%= JSON.stringify(e.details) %></td>
      </tr>
    <% }) %>
    <% if (!entries.length) { %><tr><td class="muted" colspan="5">No audit entries yet.</td></tr><% } %>
  </table>
</div>

<%- include('partials/foot') %>
