<%- include('partials/head') %>

<div class="panel">
  <p class="muted" style="margin-bottom:16px">
    Assign an approved partner agent to a case, mark a case won to record the commission owed, and — for oversight —
    read the direct agent↔client message thread (you're not part of these conversations, but you can always see them).
  </p>
  <table>
    <tr><th>Name</th><th>WhatsApp</th><th>Pathway</th><th>Stage</th><th>Client self-report</th><th>Status</th><th>Agent</th><th>Commission</th><th>Updated</th><th></th><th>Relocate modules &amp; items</th></tr>
    <% applications.forEach(a => { %>
      <tr>
        <td><%= a.name || '—' %></td>
        <td><%= a.whatsapp_number %></td>
        <td><%= a.pathway %></td>
        <td>
          <form method="post" action="/admin/applications/<%= a.id %>/stage" class="inline-form">
            <select name="stage" onchange="this.form.submit()">
              <% stageOptions.forEach(function(s) { %>
                <option value="<%= s.value %>" <%= a.stage === s.value ? 'selected' : '' %>><%= s.label %></option>
              <% }) %>
            </select>
          </form>
        </td>
        <td class="muted"><%= a.relocate_phase || '—' %></td>
        <td><%= a.status %></td>
        <td>
          <form method="post" action="/admin/applications/<%= a.id %>/vendor" class="inline-form">
            <select name="vendor_id" onchange="this.form.submit()">
              <option value="">— none —</option>
              <% approvedVendors.forEach(function(v) { %>
                <option value="<%= v.id %>" <%= a.vendor && a.vendor.id === v.id ? 'selected' : '' %>><%= v.name %></option>
              <% }) %>
            </select>
          </form>
        </td>
        <td>
          <% a.commissions.forEach(function(c) { %>
            <div style="margin-bottom:4px">
              <span class="badge <%= c.status === 'paid' ? 'green' : 'warm' %>">₦<%= c.amount.toLocaleString() %> <%= c.status %></span>
              <% if (c.status === 'owed') { %>
                <form method="post" action="/admin/commissions/<%= c.id %>/mark-paid" class="inline-form">
                  <button class="btn secondary" type="submit" style="font-size:11px;padding:2px 8px">Mark Paid</button>
                </form>
              <% } %>
            </div>
          <% }) %>
          <% if (a.vendor) { %>
            <details class="edit-row">
              <summary>Mark won</summary>
              <form class="field-form" method="post" action="/admin/applications/<%= a.id %>/mark-won">
                <div class="field"><input name="case_value" type="number" min="1" step="1" placeholder="Case value (₦)" required /></div>
                <button class="btn secondary" type="submit">Record Commission</button>
              </form>
            </details>
          <% } %>
        </td>
        <td class="muted"><%= new Date(a.updated_at).toLocaleString() %></td>
        <td>
          <% if (a.vendor) { %>
            <details class="edit-row">
              <summary>Messages</summary>
              <div style="max-width:280px;max-height:220px;overflow-y:auto;font-size:12px">
                <% (messagesByApplication[a.id] || []).forEach(function(m) { %>
                  <div style="margin-bottom:6px">
                    <b><%= m.sender_type === 'vendor' ? 'Agent' : 'Client' %>:</b> <%= m.body %>
                    <div class="muted" style="font-size:10.5px"><%= new Date(m.created_at).toLocaleString() %></div>
                  </div>
                <% }) %>
                <% if (!(messagesByApplication[a.id] || []).length) { %><span class="muted">No messages yet.</span><% } %>
              </div>
            </details>
          <% } %>
        </td>
        <td>
          <form method="post" action="/admin/applications/<%= a.id %>/reference" class="inline-form" style="margin-bottom:6px">
            <input type="text" name="government_reference_number" value="<%= a.government_reference_number || '' %>" placeholder="Application reference #" style="font-size:12px" />
            <button class="btn secondary" type="submit" style="font-size:11px;padding:2px 8px">Save</button>
          </form>
          <div style="margin-bottom:6px">
            <% if (a.departure_module_enabled) { %><span class="badge green">Departure ✓</span>
            <% } else { %>
              <form method="post" action="/admin/applications/<%= a.id %>/enable-module" class="inline-form">
                <input type="hidden" name="module" value="departure" />
                <button class="btn secondary" type="submit" style="font-size:11px;padding:2px 8px">Enable departure</button>
              </form>
            <% } %>
            <% if (a.settlement_module_enabled) { %><span class="badge green">Settlement ✓</span>
            <% } else { %>
              <form method="post" action="/admin/applications/<%= a.id %>/enable-module" class="inline-form">
                <input type="hidden" name="module" value="settlement" />
                <button class="btn secondary" type="submit" style="font-size:11px;padding:2px 8px">Enable settlement</button>
              </form>
            <% } %>
          </div>
          <details class="edit-row">
            <summary>Service Items</summary>
            <div style="max-width:300px;max-height:220px;overflow-y:auto;font-size:12px;margin-bottom:8px">
              <% (serviceItemsByApplication[a.id] || []).forEach(function(i) { %>
                <div style="margin-bottom:6px">
                  <b><%= i.title %></b> (<%= i.category %>) — <%= i.status %>
                  <% if (i.fee) { %> — <%= i.currency %> <%= i.fee.toLocaleString() %><% } %>
                  <% if (i.deadline) { %> — due <%= i.deadline %><% } %>
                  <form method="post" action="/admin/service-items/<%= i.id %>/status" class="inline-form">
                    <select name="status" onchange="this.form.submit()">
                      <% ['requested','in_progress','done','cancelled'].forEach(function(s) { %>
                        <option value="<%= s %>" <%= s === i.status ? 'selected' : '' %>><%= s %></option>
                      <% }) %>
                    </select>
                  </form>
                </div>
              <% }) %>
              <% if (!(serviceItemsByApplication[a.id] || []).length) { %><span class="muted">No service items.</span><% } %>
            </div>
            <form class="field-form" method="post" action="/admin/applications/<%= a.id %>/service-items">
              <div class="field">
                <select name="category">
                  <option value="document_coordination">Document coordination</option>
                  <option value="specialist_service">Specialist service</option>
                  <option value="application_followup">Application follow-up</option>
                  <option value="pre_departure">Pre-departure</option>
                  <option value="settlement">Settlement</option>
                </select>
              </div>
              <div class="field"><input name="title" type="text" placeholder="Title" required /></div>
              <div class="field"><input name="fee" type="number" min="0" step="1" placeholder="Fee (optional)" /></div>
              <div class="field"><input name="deadline" type="date" placeholder="Deadline (optional)" /></div>
              <div class="field">
                <select name="assigned_vendor_id">
                  <option value="">— no specific agent —</option>
                  <% approvedVendors.forEach(function(v) { %>
                    <option value="<%= v.id %>"><%= v.name %></option>
                  <% }) %>
                </select>
              </div>
              <button class="btn secondary" type="submit">Add Item</button>
            </form>
          </details>
        </td>
      </tr>
    <% }) %>
    <% if (!applications.length) { %><tr><td class="muted" colspan="11">No applications yet.</td></tr><% } %>
  </table>
</div>

<%- include('partials/foot') %>
