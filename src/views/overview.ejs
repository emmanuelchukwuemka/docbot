<%- include('partials/head') %>

<div class="welcome-row">
  <div>
    <h1>Welcome back, <%= user.username %> 👋</h1>
    <div class="sub">Here's what's happening with MigraTech today.</div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-card-top">
      <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
      <div><div class="label">Total Leads</div><div class="value"><%= overview.total_leads %></div></div>
    </div>
    <div class="stat-card-foot">
      <% const tl = charts.stats.total_leads; %>
      <span class="change <%= tl.change_pct > 0 ? 'up' : tl.change_pct < 0 ? 'down' : '' %>">
        <%= tl.change_pct === null ? 'New' : (tl.change_pct > 0 ? '↑' : tl.change_pct < 0 ? '↓' : '') + Math.abs(tl.change_pct) + '%' %> vs last 7d
      </span>
      <svg class="spark" viewBox="0 0 100 32"><polyline points="<%= tl.sparkline_points %>" fill="none" stroke="var(--brand)" stroke-width="2"/></svg>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-top">
      <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-1 4 8.5 8.5 0 0 1-7.5 4.5 8.4 8.4 0 0 1-4-1L3 21l2-5.5a8.4 8.4 0 0 1-1-4A8.5 8.5 0 0 1 8.5 3a8.4 8.4 0 0 1 4-1H13a8.5 8.5 0 0 1 8 8.5z"/></svg></div>
      <div><div class="label">Active Conversations</div><div class="value"><%= overview.active_conversations %></div></div>
    </div>
    <div class="stat-card-foot">
      <% const ac = charts.stats.active_conversations; %>
      <span class="change <%= ac.change_pct > 0 ? 'up' : ac.change_pct < 0 ? 'down' : '' %>">
        <%= ac.change_pct === null ? 'New' : (ac.change_pct > 0 ? '↑' : ac.change_pct < 0 ? '↓' : '') + Math.abs(ac.change_pct) + '%' %> vs last 7d
      </span>
      <svg class="spark" viewBox="0 0 100 32"><polyline points="<%= ac.sparkline_points %>" fill="none" stroke="var(--brand)" stroke-width="2"/></svg>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-top">
      <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M12 3l8 4v5c0 5-3.4 8.7-8 10-4.6-1.3-8-5-8-10V7l8-4z"/></svg></div>
      <div><div class="label">Hot + Warm Leads</div><div class="value"><%= overview.hot_leads + overview.warm_leads %></div></div>
    </div>
    <div class="stat-card-foot">
      <% const ql = charts.stats.qualified_leads; %>
      <span class="change <%= ql.change_pct > 0 ? 'up' : ql.change_pct < 0 ? 'down' : '' %>">
        <%= ql.change_pct === null ? 'New' : (ql.change_pct > 0 ? '↑' : ql.change_pct < 0 ? '↓' : '') + Math.abs(ql.change_pct) + '%' %> vs last 7d
      </span>
      <svg class="spark" viewBox="0 0 100 32"><polyline points="<%= ql.sparkline_points %>" fill="none" stroke="var(--warm)" stroke-width="2"/></svg>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-top">
      <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg></div>
      <div><div class="label">Consultations</div><div class="value"><%= overview.consultations_requested %></div></div>
    </div>
    <div class="stat-card-foot">
      <% const cs = charts.stats.consultations; %>
      <span class="change <%= cs.change_pct > 0 ? 'up' : cs.change_pct < 0 ? 'down' : '' %>">
        <%= cs.change_pct === null ? 'New' : (cs.change_pct > 0 ? '↑' : cs.change_pct < 0 ? '↓' : '') + Math.abs(cs.change_pct) + '%' %> vs last 7d
      </span>
      <svg class="spark" viewBox="0 0 100 32"><polyline points="<%= cs.sparkline_points %>" fill="none" stroke="var(--brand)" stroke-width="2"/></svg>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-top">
      <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg></div>
      <div><div class="label">Revenue Collected</div><div class="value">₦<%= paymentStats.collected.toLocaleString() %></div></div>
    </div>
    <div class="stat-card-foot">
      <span class="change">₦<%= paymentStats.pending.toLocaleString() %> pending</span>
      <a href="/admin/payments" style="font-size:12px;font-weight:600;">View →</a>
    </div>
  </div>
</div>

<div class="dash-grid">
  <div class="panel">
    <div class="panel-head">
      <h2>Activity — last 14 days</h2>
      <div class="chart-legend">
        <span><i style="background:var(--brand)"></i>Conversations</span>
        <span><i style="background:#3b82f6"></i>New leads</span>
      </div>
    </div>
    <svg width="100%" height="180" viewBox="0 0 680 180" preserveAspectRatio="none">
      <polygon points="<%= charts.conversations_trend_area_points %>" fill="color-mix(in srgb, var(--brand) 12%, transparent)" />
      <polyline points="<%= charts.conversations_trend_points %>" fill="none" stroke="var(--brand)" stroke-width="2" />
      <polyline points="<%= charts.leads_trend_points %>" fill="none" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4 3" />
    </svg>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h2>Recent Leads</h2>
      <a href="/admin/leads">View all</a>
    </div>
    <% recentLeads.forEach(l => { %>
      <div class="recent-row">
        <div class="avatar-circle" style="width:32px;height:32px;font-size:11px;"><%= (l.name || l.whatsapp_number).slice(0,2).toUpperCase() %></div>
        <div class="who">
          <b><%= l.name || l.whatsapp_number %></b>
          <span><%= l.whatsapp_number %></span>
        </div>
        <span class="badge <%= l.classification.toLowerCase() %>"><%= l.classification %></span>
      </div>
    <% }) %>
    <% if (!recentLeads.length) { %><p class="muted" style="padding-top:8px;">No leads yet.</p><% } %>
  </div>
</div>

<div class="dash-grid-2">
  <div class="panel">
    <div class="panel-head"><h2>Leads by Classification</h2></div>
    <% const donutColors = { HOT: 'var(--hot)', WARM: 'var(--warm)', COLD: 'var(--cold)' }; %>
    <% let cum = 0; const stops = charts.leads_by_classification.map(c => { const start = cum; cum += c.pct; return { ...c, start, end: cum }; }); %>
    <div class="donut-wrap">
      <div class="donut" style="background: conic-gradient(<% stops.forEach((s, i) => { %><%= donutColors[s.classification] %> <%= s.start %>% <%= s.end %>%<%= i < stops.length - 1 ? ', ' : '' %><% }) %>);"></div>
      <div class="donut-legend">
        <% charts.leads_by_classification.forEach(c => { %>
          <div class="donut-legend-row"><i style="background:<%= donutColors[c.classification] %>"></i><%= c.classification %><b><%= c.count %> (<%= c.pct %>%)</b></div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h2>Tasks Overview</h2>
      <a href="/admin/tasks">View all</a>
    </div>
    <div class="mini-stats">
      <div class="mini-stat"><b><%= taskStats.pending %></b><span>Pending</span></div>
      <div class="mini-stat warn"><b><%= taskStats.due_today %></b><span>Due today</span></div>
      <div class="mini-stat danger"><b><%= taskStats.overdue %></b><span>Overdue</span></div>
      <div class="mini-stat ok"><b><%= taskStats.completed %></b><span>Completed</span></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Top Migration Pathways</h2></div>
    <% if (!charts.top_pathways.length) { %><p class="muted">No profile data yet.</p><% } %>
    <% charts.top_pathways.forEach(p => { %>
      <div class="recent-row">
        <div class="who"><b style="font-size:12.5px;"><%= p.label %></b></div>
        <span class="muted" style="font-size:11.5px;"><%= p.count %> · <%= p.pct %>%</span>
      </div>
    <% }) %>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h2>Quick Actions</h2></div>
  <div class="quick-actions">
    <a class="quick-action" href="/admin/leads">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg></div>
      View Leads
    </a>
    <a class="quick-action" href="/admin/documents">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
      Review Documents
    </a>
    <a class="quick-action" href="/admin/tasks">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
      Add Task
    </a>
    <a class="quick-action" href="/admin/knowledge">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      Knowledge Base
    </a>
    <a class="quick-action" href="/admin/payments">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg></div>
      Record Payment
    </a>
    <a class="quick-action" href="/admin/search">
      <div class="quick-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></div>
      Search
    </a>
  </div>
</div>

<div class="insight-banner">
  <div class="insight-banner-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13 19v-5.5l8 2.5z"/></svg></div>
  <p>
    <% const trend = charts.stats.total_leads.change_pct; %>
    <% if (trend === null && overview.total_leads > 0) { %>
      You've picked up <b><%= overview.new_users_7d %> new contact<%= overview.new_users_7d === 1 ? '' : 's' %></b> this week — no prior-week baseline to compare against yet.
    <% } else if (trend === 0 && overview.total_leads === 0) { %>
      No lead activity yet — <b>MigraTech</b> is ready and waiting for your first WhatsApp conversation.
    <% } else if (trend > 0) { %>
      Lead volume is <b>up <%= trend %>%</b> vs the previous 7 days. Keep an eye on the Leads page to follow up while they're warm.
    <% } else if (trend < 0) { %>
      Lead volume is <b>down <%= Math.abs(trend) %>%</b> vs the previous 7 days.
    <% } else { %>
      Lead volume is flat vs the previous 7 days.
    <% } %>
  </p>
</div>

<%- include('partials/foot') %>
