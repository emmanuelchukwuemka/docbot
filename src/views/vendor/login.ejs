<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Agent Login — MigraTech</title>
<link rel="icon" type="image/png" href="/brand/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/portal.css" />
</head>
<body>

<%- include('../portal/partials/nav') %>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-eyebrow">Partner Portal</div>
    <h1>Agent Login</h1>
    <p class="auth-sub">Log in to manage your cases, messages, and earnings.</p>

    <% if (error) { %><div class="auth-flash error"><%= error %></div><% } %>

    <form method="post" action="/agents/login">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autofocus />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required />
      </div>

      <button type="submit" class="auth-submit">Log in</button>
    </form>

    <div class="auth-switch">Not a partner yet? <a href="/agents/apply">Apply to become an agent</a></div>
    <div class="auth-switch" style="margin-top:8px">Looking for your MigraTech client account? <a href="/login">Log in here</a></div>
  </div>
</div>

<%- include('../portal/partials/footer') %>

</body>
</html>
