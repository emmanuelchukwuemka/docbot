<%- include('partials/head') %>

<div class="panel">
  <h2>Consultations</h2>
  <p class="muted" style="margin-bottom:16px">Consultation bookings from clients on your cases.</p>
  <table>
    <tr><th>Client</th><th>Preferred time</th><th>Status</th><th>Requested</th></tr>
    <% consultations.forEach(function(c) { %>
      <tr>
        <td><b><%= c.client_name %></b></td>
        <td><%= c.preferred_time_text || '—' %></td>
        <td>
          <% if (c.status === 'requested') { %><span class="badge warm">requested</span>
          <% } else if (c.status === 'confirmed') { %><span class="badge green">confirmed</span>
          <% } else { %><span class="badge neutral"><%= c.status %></span><% } %>
        </td>
        <td class="muted"><%= new Date(c.created_at).toLocaleDateString() %></td>
      </tr>
    <% }) %>
    <% if (!consultations.length) { %><tr><td class="muted" colspan="4">No consultations yet.</td></tr><% } %>
  </table>
</div>

<%- include('partials/foot') %>
